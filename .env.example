# 复制一份改名为 .env，把密码换成本机 PostgreSQL 的 postgres 用户密码。.env 永远不提交。
DATABASE_URL="postgresql://postgres:你的密码@localhost:5432/dianyoushu_erp?schema=public"

# 会话 cookie 的签名密钥：一长串随机字符，可以用 node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" 生成。
# 本机开发至少 16 个字符；生产环境（next start / Docker）至少 32 个字符，还是这里的占位值会拒绝启动（src/instrumentation.ts）。
SESSION_SECRET="换成你自己的随机字符串"

# 个人信息加密（口径第 20 节）：手机号、身份证号存密文和指纹用的两把钥匙，各是 32 字节的 base64，两把不能一样。
# 用 node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" 各生成一个。必填（本机跑 pnpm db:reset 也要）；
# 生产环境没配、格式不对或用了公开的开发钥匙，应用拒绝启动。一定要另外离线存一份：加密钥匙丢了号码就解不开，指纹钥匙丢了就搜不到。
DATA_ENCRYPTION_KEY=
DATA_INDEX_KEY=

# 下面三个只有服务器上的 docker compose 用（口径第 20 节）：应用连库用的业务账号、只读账号的密码，备份加密口令。
# 两个数据库密码用 openssl rand -hex 32（只有数字字母；base64 会带 /，拼进连接串就连不上），BACKUP_PASSPHRASE 用 openssl rand -base64 32；
# BACKUP_PASSPHRASE 一定另外离线存一份，丢了备份打不开。本机开发不用填。
APP_DB_PASSWORD=
READONLY_DB_PASSWORD=
BACKUP_PASSPHRASE=

# 演示模式：1 = 演示站（4 个演示账号受保护、登录页显示演示账号、允许 db:reset）；真给门店用写 0。见 docs/部署.md 上线前检查清单
# 本机开发不写也行（按演示站算）；生产环境（next start / Docker）必须写明，不写应用拒绝启动。
DEMO_MODE=1

# 企业微信（口径第 12 节）。WECOM_ENABLED=1 才真调企业微信接口、打开回调地址 /api/wecom/callback；
# 不写或 0：演示站里是模拟模式（不连企业微信，销售单详情里有“模拟客户扫码加好友”），DEMO_MODE=0 时整个模块不显示。
# 只用一个自建应用的 Secret（2023-12-01 起新企业不能再用系统应用的 Secret 调接口），在企业微信后台把这个应用设为客户联系“可调用接口的应用”。
# 这些值都是密钥，只写在 .env 里，不进仓库。
WECOM_ENABLED=0
WECOM_CORP_ID=
WECOM_APP_SECRET=
WECOM_AGENT_ID=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=

# 智能提醒（口径第 18 节）：1 = 真把今日待办推到企业微信门店群（群机器人地址在组织管理的门店里填）；不写或 0 只发系统内消息，推群记“演示：没有真发”。
ALERT_PUSH_ENABLED=0

# 大模型（智能提醒写“今日待办”，口径第 18 节）。OpenAI 兼容接口，DeepSeek、通义千问都行，换哪家只改这三项。
# 不写或 LLM_ENABLED=0：演示站用模拟模型，真给门店用（DEMO_MODE=0）只发模板版。密钥只写在服务器的 .env 里，不进仓库；
# 记得在模型服务商后台设消费上限。LLM_DAILY_LIMIT 是每天最多调几次（默认 200），LLM_TIMEOUT_MS 默认 20000。
LLM_ENABLED=0
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
