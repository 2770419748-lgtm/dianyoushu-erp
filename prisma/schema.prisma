// 店有数 ERP 数据表定义（第 3 天，按 docs/业务口径.md v0 设计，中文说明见 docs/数据模型.md）。
// 约定：模型 PascalCase、字段 camelCase，用 @@map/@map 映射到 snake_case 表名和列名；
// 金额一律整数"分"，字段名以 Fen 结尾；数量字段 qty；单据不物理删除，只有作废状态。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// 枚举
// ============================================================

/// 角色：店员、店长、区域经理、总部
enum Role {
  STAFF            // 店员
  STORE_MANAGER    // 店长
  REGIONAL_MANAGER // 区域经理
  HQ               // 总部

  @@map("role")
}

/// 商品管理方式：大件按串号一机一码，小件按数量
enum SkuKind {
  DEVICE    // 大件：手机、平板、电脑
  ACCESSORY // 小件：配件、号卡

  @@map("sku_kind")
}

/// 串号机器状态（口径第 4 节状态机）
enum DeviceStatus {
  IN_TRANSIT  // 在途：调拨已发出未收货
  IN_STOCK    // 在库：可开单
  SOLD        // 已售
  RECYCLED    // 回收：以旧换新收回的旧机，未检测
  REFURBISHED // 良品：回收机检测合格，可开单
  LOCKED      // 锁定：调拨已申请未发出
  LOST        // 盘亏：盘点确认少了

  @@map("device_status")
}

enum PurchaseOrderStatus {
  DRAFT     // 草稿
  SUBMITTED // 已提交
  RECEIVED  // 已到货（全部到齐）
  VOIDED    // 已作废

  @@map("purchase_order_status")
}

enum TransferStatus {
  REQUESTED // 申请
  SHIPPED   // 已发出
  RECEIVED  // 已收货
  VOIDED    // 已作废

  @@map("transfer_status")
}

enum StocktakeStatus {
  IN_PROGRESS // 进行中
  CONFIRMED   // 已确认
  VOIDED      // 已作废

  @@map("stocktake_status")
}

enum SalesOrderStatus {
  COMPLETED // 已完成
  VOIDED    // 已作废

  @@map("sales_order_status")
}

enum TradeInStatus {
  COMPLETED // 已完成
  VOIDED    // 已作废

  @@map("trade_in_status")
}

/// 服务权益状态（口径第 12 节）：过没过期按到期日算，不单独存
enum EntitlementStatus {
  ACTIVE  // 有效
  VOIDED  // 失效：退货退掉了服务，或销售单作废
  CLAIMED // 已理赔：碎屏险在维修单上用掉了（口径第 13 节，只能用一次）

  @@map("entitlement_status")
}

/// 服务类商品的种类（口径第 13 节）：决定维修时能不能用、能用几次
enum ServiceKind {
  SCREEN_INSURANCE  // 碎屏险：屏幕故障，理赔一次
  EXTENDED_WARRANTY // 延保：非人为故障，期内不限次数
  OTHER             // 其他：不能用来维修

  @@map("service_kind")
}

/// 维修单状态（口径第 13 节）
enum RepairStatus {
  RECEIVED  // 已接件
  QUOTED    // 已报价，等客户确认
  REPAIRING // 维修中
  READY     // 待取机（修好了，或客户不修、修不好）
  CLOSED    // 已完结（客户取走、结清）
  VOIDED    // 已作废

  @@map("repair_status")
}

/// 维修谁来付
enum RepairPayer {
  CUSTOMER          // 客户自费
  WARRANTY          // 保修（本店卖出 12 个月内，非屏幕、进水）
  SCREEN_INSURANCE  // 碎屏险理赔
  EXTENDED_WARRANTY // 延保

  @@map("repair_payer")
}

/// 维修结果
enum RepairOutcome {
  REPAIRED     // 修好了
  NOT_REPAIRED // 客户不修，或修不好

  @@map("repair_outcome")
}

/// 运营商（口径第 14 节）
enum Carrier {
  CMCC // 中国移动
  CUCC // 中国联通
  CTCC // 中国电信
  CBN  // 中国广电

  @@map("carrier")
}

/// 运营商业务类型
enum CarrierBizType {
  NEW_LINE       // 新号入网
  PORT_IN        // 携号转入
  CONTRACT_PHONE // 合约机（购机送话费）
  BROADBAND      // 宽带
  PLAN_UPGRADE   // 套餐升级

  @@map("carrier_biz_type")
}

/// 运营商业务单状态
enum CarrierBizStatus {
  SUBMITTED   // 已登记
  ACTIVATED   // 已开通
  FAILED      // 办理失败
  SETTLED     // 已结算（收到佣金）
  CLAWED_BACK // 已返销（佣金被扣回）
  VOIDED      // 已作废

  @@map("carrier_biz_status")
}

/// 运营商结算单从哪来
enum CarrierSettlementSource {
  FILE      // 导入运营商渠道系统导出的 CSV
  SIMULATED // 演示里生成的模拟结算单

  @@map("carrier_settlement_source")
}

/// 结算单一行的对账结果
enum CarrierLineResult {
  MATCHED   // 对上了，金额也一样
  DIFF      // 对上了，佣金和预计的不一样
  UNMATCHED // 运营商有、我们没登记

  @@map("carrier_line_result")
}

/// 故障类型
enum FaultCategory {
  SCREEN   // 屏幕
  BATTERY  // 电池
  BOARD    // 主板
  CAMERA   // 摄像头
  WATER    // 进水
  SOFTWARE // 软件
  OTHER    // 其他

  @@map("fault_category")
}

/// 到期提醒的档位：剩 8～30 天一档、剩 0～7 天一档，每档对同一条权益只提醒一次
enum ReminderStage {
  T30 // 剩 8～30 天
  T7  // 剩 0～7 天

  @@map("reminder_stage")
}

/// 企业微信跟进关系状态（口径第 12 节）
enum WecomFollowStatus {
  ACTIVE  // 正常跟进中
  DELETED // 删了：员工删了客户（del_external_contact）或客户删了员工（del_follow_user），见 deletedBy

  @@map("wecom_follow_status")
}

/// 企业微信回调事件的处理状态
enum WecomEventStatus {
  PENDING   // 刚落库，还没处理完
  PROCESSED // 处理完了（没有对应处理的事件也算处理完）
  FAILED    // 处理出错，error 里有原因，每日脚本重放

  @@map("wecom_event_status")
}

/// 客户标签从哪来
/// 智能提醒的规则（口径第 18 节）
enum AlertKind {
  STALE_DEVICES    // 滞销机器
  LOW_ACCESSORY    // 配件缺货
  KPI_BEHIND       // KPI 落后
  DAILY_CLOSE      // 日结没做完
  TRANSFER_PENDING // 调拨没收货
  STOCKTAKE_OPEN   // 盘点没确认
  TRADE_IN_IDLE    // 回收机没处理
  APPROVAL_PENDING // 待审批
  TRANSFER_SUGGEST // 调拨建议
  INTEGRITY        // 对账自检

  @@map("alert_kind")
}

/// 提醒和今日待办是给谁的
enum AlertScope {
  STORE  // 门店（店长、店员）
  REGION // 区域（区域经理）
  HQ     // 总部

  @@map("alert_scope")
}

/// 今日待办是谁写的
enum AlertDigestSource {
  MODEL     // 真大模型
  SIMULATED // 模拟模型（演示站没配模型时）
  TEMPLATE  // 模板（没开模型，或模型出错、超额、写了清单外的数字）

  @@map("alert_digest_source")
}

/// 企业微信客户继承的种类（口径第 12 节第三步）
enum WecomTransferKind {
  ON_JOB   // 在职转接：店长、总部把一个员工的客户转给另一个员工
  RESIGNED // 离职继承：员工离职，客户交给接手人（要先在企业微信后台删掉这个成员）

  @@map("wecom_transfer_kind")
}

/// 企业微信客户继承的进度
enum WecomTransferStatus {
  WAITING_DELETE // 离职继承：等企业微信后台删除这个成员，删了才能提交
  SUBMITTED      // 已提交，等客户接替（客户 24 小时内可以拒绝）
  DONE           // 接替完毕：跟进关系转到接手人名下
  REFUSED        // 客户拒绝了
  FAILED         // 其他原因没成（接手人客户数到上限、企业微信报错……），error 里写原因

  @@map("wecom_transfer_status")
}

/// 微信客服会话现在谁在接（口径第 12 节第三步）
enum WecomKfSessionState {
  AUTO  // 自动答复
  HUMAN // 转人工了，不再自动答复，等人工会话结束

  @@map("wecom_kf_session_state")
}

/// 微信客服消息的方向
enum WecomKfDirection {
  IN  // 客户发来的
  OUT // 发给客户的（自动答复，或者人工在企业微信里回的）

  @@map("wecom_kf_direction")
}

enum WecomTagSource {
  AUTO   // 系统规则打的（这一版没做自动规则）
  MANUAL // 员工在 ERP 里打的
  WECOM  // 企业微信那边打的，同步回来

  @@map("wecom_tag_source")
}

enum DailyCloseStatus {
  PENDING   // 未确认
  CONFIRMED // 已确认

  @@map("daily_close_status")
}

/// 支付方式（口径第 6 节）
enum PaymentMethod {
  CASH        // 现金
  WECHAT      // 微信
  ALIPAY      // 支付宝
  CARD        // 刷卡
  INSTALLMENT // 分期
  TRADE_IN    // 以旧换新抵扣
  OTHER       // 其他
  SUBSIDY     // 国补立减（口径第 15 节，系统按政策算，不能手选）

  @@map("payment_method")
}

/// 审批规则的场景（口径第 17 节）
enum ApprovalRuleKind {
  SALE_DISCOUNT   // 开单让利
  SALE_BELOW_COST // 低于成本卖
  RETURN_REFUND   // 退货退款
  SALE_VOID       // 作废销售单
  TRANSFER        // 调拨
  STOCKTAKE_LOSS  // 盘点盘亏

  @@map("approval_rule_kind")
}

/// 审批单要做的事
enum ApprovalAction {
  SALE      // 开单
  RETURN    // 退货
  SALE_VOID // 作废销售单
  TRANSFER  // 调拨申请
  STOCKTAKE // 盘点确认

  @@map("approval_action")
}

enum ApprovalStatus {
  PENDING   // 待审批
  EXECUTED  // 已通过（已经做掉）
  FAILED    // 批了，但这时候做不成了
  REJECTED  // 已驳回
  CANCELLED // 发起人撤回

  @@map("approval_status")
}

/// 发票种类（口径第 16 节）
enum InvoiceKind {
  E_NORMAL     // 电子普票
  E_SPECIAL    // 电子专票
  PAPER_NORMAL // 纸质普票

  @@map("invoice_kind")
}

enum InvoiceTitleType {
  PERSONAL // 个人
  COMPANY  // 企业

  @@map("invoice_title_type")
}

/// 发票状态（口径第 16 节）
enum InvoiceStatus {
  REQUESTED   // 待开票
  ISSUED      // 已开票
  RED_PENDING // 需红冲：开了之后退货、作废
  REDDED      // 已红冲
  CANCELLED   // 已撤回

  @@map("invoice_status")
}

/// 发票号码怎么来的：演示里模拟开具，真用时在电子税务局开好回来登记
enum InvoiceIssueSource {
  SIMULATED
  MANUAL

  @@map("invoice_issue_source")
}

/// 国补单状态（口径第 15 节）
enum SubsidyClaimStatus {
  PENDING    // 待提交：开单时生成，要补资料
  SUBMITTED  // 审核中：已提交平台审核
  APPROVED   // 待到账：平台审核通过
  SETTLED    // 已到账
  REJECTED   // 被驳回
  CANCELLED  // 已撤销：没到账时作废、退货
  RETURN_DUE // 需退回：已到账后退货
  RETURNED   // 已退回给平台

  @@map("subsidy_claim_status")
}

/// 库存流水的单据类型
enum LedgerDocType {
  PURCHASE_RECEIPT // 采购入库 +
  TRANSFER_LOCK    // 调拨申请锁定（数量不变，只记状态）
  TRANSFER_UNLOCK  // 调拨作废解锁（数量不变）
  TRANSFER_OUT     // 调拨发出 −
  TRANSFER_IN      // 调拨收货 +
  STOCKTAKE_GAIN   // 盘盈 +
  STOCKTAKE_LOSS   // 盘亏 −
  SALE             // 销售出库 −
  SALE_VOID        // 销售作废恢复 +
  RETURN           // 退货入库 +
  TRADE_IN         // 回收入库 +
  REFURBISH        // 回收转良品（数量不变，只记状态）

  @@map("ledger_doc_type")
}

// ============================================================
// 组织与用户
// ============================================================

/// 区域
model Region {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stores Store[]
  users  User[]

  @@map("regions")
}

/// 门店
model Store {
  id        Int      @id @default(autoincrement())
  code      String   @unique // 门店编码，如 S001
  name      String
  regionId  Int      @map("region_id")
  address   String?
  wecomWebhookUrl String? @map("wecom_webhook_url") // 企业微信门店群机器人地址（带密钥，页面只显示有没有填；智能提醒推送用，口径第 18 节）
  isActive  Boolean  @default(true) @map("is_active") // 停用不删
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  region Region @relation(fields: [regionId], references: [id])

  users           User[]
  storePrices     StorePrice[]
  devices         Device[]
  accessoryStocks AccessoryStock[]
  ledgers         StockLedger[]
  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  transfersOut    TransferOrder[]  @relation("TransferFromStore")
  transfersIn     TransferOrder[]  @relation("TransferToStore")
  stocktakes      Stocktake[]
  salesOrders     SalesOrder[]
  returnOrders    ReturnOrder[]
  tradeInOrders   TradeInOrder[]
  dailyCloses     DailyClose[]
  entitlements    ServiceEntitlement[]
  repairOrders    RepairOrder[]
  carrierBusiness CarrierBusiness[]
  subsidyClaims   SubsidyClaim[]
  invoices        Invoice[]
  approvals       ApprovalRequest[]
  wecomBindCodes  WecomBindCode[]
  kpiTargets      KpiTarget[]

  @@index([regionId])
  @@map("stores")
}

/// 员工即登录用户
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique // 登录账号
  passwordHash String   @map("password_hash") // bcrypt 哈希，永远不存明文
  sessionVersion Int    @default(0) @map("session_version") // 会话版本号：改密码、停用、启用时 +1，之前签发的登录令牌立刻作废
  wecomUserid    String? @unique @map("wecom_userid") // 员工在企业微信里的账号（userid），组织管理里填
  name         String // 姓名
  role         Role
  storeId      Int?     @map("store_id") // 店员、店长必填；区域经理、总部为空
  regionId     Int?     @map("region_id") // 区域经理所辖区域
  isActive     Boolean  @default(true) @map("is_active") // 离职/停用不删
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  store  Store?  @relation(fields: [storeId], references: [id])
  region Region? @relation(fields: [regionId], references: [id])

  purchaseOrdersCreated PurchaseOrder[]
  goodsReceipts         GoodsReceipt[]
  transfersRequested    TransferOrder[] @relation("TransferRequestedBy")
  transfersShipped      TransferOrder[] @relation("TransferShippedBy")
  transfersReceived     TransferOrder[] @relation("TransferReceivedBy")
  stocktakesCreated     Stocktake[]     @relation("StocktakeCreatedBy")
  stocktakesConfirmed   Stocktake[]     @relation("StocktakeConfirmedBy")
  salesOrders           SalesOrder[]    @relation("SalesOrderSalesperson")
  salesOrdersVoided     SalesOrder[]    @relation("SalesOrderVoidedBy")
  returnOrders          ReturnOrder[]
  tradeInOrders         TradeInOrder[]  @relation("TradeInHandledBy")
  tradeInOrdersVoided   TradeInOrder[]  @relation("TradeInVoidedBy")
  dailyClosesConfirmed  DailyClose[]
  ledgers               StockLedger[]
  auditLogs             AuditLog[]
  remindersContacted    EntitlementReminder[]
  repairsReceived       RepairOrder[] @relation("RepairReceivedBy")
  repairsClosed         RepairOrder[] @relation("RepairClosedBy")
  repairsVoided         RepairOrder[] @relation("RepairVoidedBy")
  carrierHandled        CarrierBusiness[] @relation("CarrierHandledBy")
  carrierVoided         CarrierBusiness[] @relation("CarrierVoidedBy")
  invoicesRequested     Invoice[]         @relation("InvoiceRequestedBy")
  invoicesIssued        Invoice[]         @relation("InvoiceIssuedBy")
  invoicesRedded        Invoice[]         @relation("InvoiceRedBy")
  approvalsRequested    ApprovalRequest[] @relation("ApprovalRequestedBy")
  approvalsDecided      ApprovalRequest[] @relation("ApprovalDecidedBy")
  carrierSettlements    CarrierSettlement[]
  wecomFollows          WecomFollow[]
  wecomBindCodes        WecomBindCode[]
  wecomTransfersFrom    WecomTransfer[] @relation("WecomTransferFrom")
  wecomTransfersTo      WecomTransfer[] @relation("WecomTransferTo")
  wecomTransfersCreated WecomTransfer[] @relation("WecomTransferCreatedBy")
  notifications         Notification[]

  @@index([storeId])
  @@index([regionId])
  @@map("users")
}

// ============================================================
// 商品主数据
// ============================================================

/// 品类：一级，带大件/小件标记
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  kind      SkuKind
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")

  models          ProductModel[]
  subsidyPolicies SubsidyPolicy[]
  subsidyClaims   SubsidyClaim[]

  @@map("categories")
}

/// 品牌
model Brand {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true) @map("is_active")

  models ProductModel[]

  @@map("brands")
}

/// 型号：品牌 + 品类 + 名称，如 华为 Mate 70
model ProductModel {
  id         Int      @id @default(autoincrement())
  brandId    Int      @map("brand_id")
  categoryId Int      @map("category_id")
  name       String
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  brand    Brand    @relation(fields: [brandId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  skus     Sku[]

  @@unique([brandId, name])
  @@index([categoryId])
  @@map("product_models")
}

/// SKU = 型号 + 颜色 + 容量
model Sku {
  id            Int      @id @default(autoincrement())
  modelId       Int      @map("model_id")
  name          String // 显示名，如 "Mate 70 12GB+256GB 曜金黑"
  color         String?
  storage       String? // 容量，如 "12GB+256GB"
  barcode       String?  @unique
  guidePriceFen Int      @map("guide_price_fen") // 指导价
  costPriceFen  Int      @default(0) @map("cost_price_fen") // 参考成本（小件按它算毛利）
  safetyQty     Int      @default(0) @map("safety_qty") // 小件安全库存：门店数量低于它标红；0 = 不预警
  isService     Boolean  @default(false) @map("is_service") // 服务类商品（碎屏险、延保）：开单生成权益，不管库存
  serviceMonths Int?     @map("service_months") // 服务期限（月），服务类必填 1～120（数据库 CHECK）
  serviceKind   ServiceKind? @map("service_kind") // 服务种类：碎屏险 / 延保 / 其他（维修核销用，口径第 13 节）
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  model ProductModel @relation(fields: [modelId], references: [id])

  storePrices     StorePrice[]
  devices         Device[]
  accessoryStocks AccessoryStock[]
  ledgers         StockLedger[]
  purchaseItems   PurchaseOrderItem[]
  receiptItems    GoodsReceiptItem[]
  transferItems   TransferItem[]
  stocktakeItems  StocktakeItem[]
  salesItems      SalesOrderItem[]
  returnItems     ReturnOrderItem[]
  tradeInOrders   TradeInOrder[]
  entitlements    ServiceEntitlement[]

  @@index([modelId])
  @@map("skus")
}

/// 门店售价：按门店覆盖指导价
model StorePrice {
  id        Int      @id @default(autoincrement())
  storeId   Int      @map("store_id")
  skuId     Int      @map("sku_id")
  priceFen  Int      @map("price_fen")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id])
  sku   Sku   @relation(fields: [skuId], references: [id])

  @@unique([storeId, skuId])
  @@map("store_prices")
}

// ============================================================
// 库存
// ============================================================

/// 串号机器：一台一条。大件最多三个码：SN、IMEI1、IMEI2，至少填一个，各自全局唯一；
/// code 是主码（有 IMEI1 用 IMEI1，否则 SN，否则 IMEI2），链接、显示、默认查询都用它。
model Device {
  id             Int          @id @default(autoincrement())
  code           String       @unique // 主码
  sn             String?      @unique // 序列号（机身/包装盒）
  imei1          String?      @unique // 15 位数字
  imei2          String?      @unique // 15 位数字，双卡机第二个
  skuId          Int          @map("sku_id")
  storeId        Int          @map("store_id") // 当前归属门店；在途时仍是发出店
  status         DeviceStatus
  costFen        Int          @map("cost_fen") // 采购成本或回收估价
  condition      String? // 成色（回收机）
  goodsReceiptId Int?         @map("goods_receipt_id") // 采购入库来源
  tradeInOrderId Int?         @unique @map("trade_in_order_id") // 回收来源
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  sku          Sku           @relation(fields: [skuId], references: [id])
  store        Store         @relation(fields: [storeId], references: [id])
  goodsReceipt GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id])
  tradeInOrder TradeInOrder? @relation(fields: [tradeInOrderId], references: [id])

  ledgers        StockLedger[]
  transferItems  TransferItem[]
  stocktakeItems StocktakeItem[]
  salesItems     SalesOrderItem[]
  returnItems    ReturnOrderItem[]
  entitlements   ServiceEntitlement[]
  repairOrders   RepairOrder[]
  subsidyClaims  SubsidyClaim[]

  @@index([storeId, status])
  @@index([skuId])
  @@map("devices")
}

/// 配件库存余额：门店 × SKU × 数量（由流水在同一事务里维护，永远能从流水重算）
model AccessoryStock {
  id        Int      @id @default(autoincrement())
  storeId   Int      @map("store_id")
  skuId     Int      @map("sku_id")
  qty       Int      @default(0) // 数据库 CHECK qty >= 0（迁移 integrity_checks）
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id])
  sku   Sku   @relation(fields: [skuId], references: [id])

  @@unique([storeId, skuId])
  @@map("accessory_stocks")
}

/// 库存流水：每一次增减一条，带单据类型和单号
model StockLedger {
  id           Int           @id @default(autoincrement())
  docType      LedgerDocType @map("doc_type")
  docNo        String        @map("doc_no")
  storeId      Int           @map("store_id")
  skuId        Int           @map("sku_id")
  deviceId     Int?          @map("device_id") // 大件必填
  qtyDelta     Int           @map("qty_delta") // 正增负减；只改状态的记 0
  balanceAfter Int?          @map("balance_after") // 小件变动后余额
  statusBefore DeviceStatus? @map("status_before")
  statusAfter  DeviceStatus? @map("status_after")
  operatorId   Int           @map("operator_id")
  note         String?
  createdAt    DateTime      @default(now()) @map("created_at")

  store    Store   @relation(fields: [storeId], references: [id])
  sku      Sku     @relation(fields: [skuId], references: [id])
  device   Device? @relation(fields: [deviceId], references: [id])
  operator User    @relation(fields: [operatorId], references: [id])

  @@index([storeId, skuId, createdAt])
  @@index([deviceId])
  @@index([docType, docNo])
  @@map("stock_ledgers")
}

// ============================================================
// 采购入库
// ============================================================

/// 采购单
model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  orderNo      String              @unique @map("order_no") // PO + yyyyMMdd + 4 位
  storeId      Int                 @map("store_id") // 收货门店
  status       PurchaseOrderStatus @default(DRAFT)
  supplierName String?             @map("supplier_name")
  note         String?
  createdById  Int                 @map("created_by_id")
  submittedAt  DateTime?           @map("submitted_at")
  receivedAt   DateTime?           @map("received_at")
  voidedAt     DateTime?           @map("voided_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  store     Store @relation(fields: [storeId], references: [id])
  createdBy User  @relation(fields: [createdById], references: [id])

  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]

  @@index([storeId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          Int @id @default(autoincrement())
  orderId     Int @map("order_id")
  skuId       Int @map("sku_id")
  qty         Int
  unitCostFen Int @map("unit_cost_fen")
  receivedQty Int @default(0) @map("received_qty")

  order PurchaseOrder @relation(fields: [orderId], references: [id])
  sku   Sku           @relation(fields: [skuId], references: [id])

  @@index([orderId])
  @@map("purchase_order_items")
}

/// 入库单：一次到货一张
model GoodsReceipt {
  id              Int      @id @default(autoincrement())
  receiptNo       String   @unique @map("receipt_no") // RI + yyyyMMdd + 4 位
  purchaseOrderId Int      @map("purchase_order_id")
  storeId         Int      @map("store_id")
  receivedById    Int      @map("received_by_id")
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  store         Store         @relation(fields: [storeId], references: [id])
  receivedBy    User          @relation(fields: [receivedById], references: [id])

  items   GoodsReceiptItem[]
  devices Device[]

  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id          Int @id @default(autoincrement())
  receiptId   Int @map("receipt_id")
  skuId       Int @map("sku_id")
  qty         Int // 大件 = 串号条数
  unitCostFen Int @map("unit_cost_fen")

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id])
  sku     Sku          @relation(fields: [skuId], references: [id])

  @@index([receiptId])
  @@map("goods_receipt_items")
}

// ============================================================
// 调拨与盘点
// ============================================================

/// 调拨单
model TransferOrder {
  id            Int            @id @default(autoincrement())
  orderNo       String         @unique @map("order_no") // TR + yyyyMMdd + 4 位
  fromStoreId   Int            @map("from_store_id")
  toStoreId     Int            @map("to_store_id")
  status        TransferStatus @default(REQUESTED)
  note          String?
  requestedById Int            @map("requested_by_id")
  shippedById   Int?           @map("shipped_by_id")
  receivedById  Int?           @map("received_by_id")
  requestedAt   DateTime       @default(now()) @map("requested_at")
  shippedAt     DateTime?      @map("shipped_at")
  receivedAt    DateTime?      @map("received_at")
  voidedAt      DateTime?      @map("voided_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  fromStore   Store @relation("TransferFromStore", fields: [fromStoreId], references: [id])
  toStore     Store @relation("TransferToStore", fields: [toStoreId], references: [id])
  requestedBy User  @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  shippedBy   User? @relation("TransferShippedBy", fields: [shippedById], references: [id])
  receivedBy  User? @relation("TransferReceivedBy", fields: [receivedById], references: [id])

  items TransferItem[]

  @@index([fromStoreId, status])
  @@index([toStoreId, status])
  @@map("transfer_orders")
}

/// 调拨明细：大件一台一行，小件一个 SKU 一行
model TransferItem {
  id          Int       @id @default(autoincrement())
  transferId  Int       @map("transfer_id")
  skuId       Int       @map("sku_id")
  deviceId    Int?      @map("device_id")
  qty         Int       @default(1)
  receivedQty Int       @default(0) @map("received_qty")
  receivedAt  DateTime? @map("received_at")

  transfer TransferOrder @relation(fields: [transferId], references: [id])
  sku      Sku           @relation(fields: [skuId], references: [id])
  device   Device?       @relation(fields: [deviceId], references: [id])

  @@unique([transferId, deviceId]) // 一台机器在一张调拨单里只能有一行
  @@index([transferId])
  @@map("transfer_items")
}

/// 盘点单
model Stocktake {
  id            Int             @id @default(autoincrement())
  stocktakeNo   String          @unique @map("stocktake_no") // ST + yyyyMMdd + 4 位
  storeId       Int             @map("store_id")
  status        StocktakeStatus @default(IN_PROGRESS)
  note          String?
  createdById   Int             @map("created_by_id")
  confirmedById Int?            @map("confirmed_by_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  confirmedAt   DateTime?       @map("confirmed_at")
  voidedAt      DateTime?       @map("voided_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  store       Store @relation(fields: [storeId], references: [id])
  createdBy   User  @relation("StocktakeCreatedBy", fields: [createdById], references: [id])
  confirmedBy User? @relation("StocktakeConfirmedBy", fields: [confirmedById], references: [id])

  items StocktakeItem[]

  @@index([storeId, status])
  @@map("stocktakes")
}

/// 盘点明细：建任务时快照应有数，录入实盘后算差异
model StocktakeItem {
  id          Int  @id @default(autoincrement())
  stocktakeId Int  @map("stocktake_id")
  skuId       Int  @map("sku_id")
  deviceId    Int? @map("device_id") // 大件一台一行
  expectedQty Int  @map("expected_qty")
  countedQty  Int? @map("counted_qty")
  diffQty     Int? @map("diff_qty") // 实盘 − 应有

  stocktake Stocktake @relation(fields: [stocktakeId], references: [id])
  sku       Sku       @relation(fields: [skuId], references: [id])
  device    Device?   @relation(fields: [deviceId], references: [id])

  @@unique([stocktakeId, deviceId]) // 一台机器在一次盘点里只能有一行（配件行 device_id 为空，不受影响）
  @@index([stocktakeId])
  @@map("stocktake_items")
}

// ============================================================
// 客户、销售、退货、回收
// ============================================================

/// 客户
model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique // 列表脱敏显示
  note      String?
  wecomExternalUserid String?   @unique @map("wecom_external_userid") // 企业微信外部联系人 id，开单绑定码加微后写入；不按手机号自动匹配
  wecomNickname       String?   @map("wecom_nickname") // 加微时的微信昵称（快照）
  wecomAvatarUrl      String?   @map("wecom_avatar_url")
  wecomBoundAt        DateTime? @map("wecom_bound_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  salesOrders   SalesOrder[]
  returnOrders  ReturnOrder[]
  tradeInOrders TradeInOrder[]
  entitlements  ServiceEntitlement[]
  repairOrders  RepairOrder[]
  carrierBusiness CarrierBusiness[]
  subsidyClaims SubsidyClaim[]
  invoices      Invoice[]
  wecomFollows  WecomFollow[]
  wecomTags     WecomCustomerTag[]
  wecomBindCodes WecomBindCode[]
  wecomKfSessions WecomKfSession[]
  wecomTransfers  WecomTransfer[]

  @@map("customers")
}

/// 销售单
model SalesOrder {
  id             Int              @id @default(autoincrement())
  orderNo        String           @unique @map("order_no") // SO + yyyyMMdd + 4 位
  storeId        Int              @map("store_id")
  customerId     Int?             @map("customer_id")
  salespersonId  Int              @map("salesperson_id")
  status         SalesOrderStatus @default(COMPLETED)
  bizDate        DateTime         @map("biz_date") @db.Date // 营业日，日结按它分组
  subtotalFen    Int              @map("subtotal_fen") // 折前合计
  discountFen    Int              @default(0) @map("discount_fen") // 整单优惠
  totalFen       Int              @map("total_fen") // 应收 = 折前 − 优惠；支付明细合计必须等于它
  tradeInOrderId Int?             @unique @map("trade_in_order_id") // 关联的回收单（以旧换新）
  dailyCloseId   Int?             @map("daily_close_id") // 日结确认后回填，之后不可作废
  note           String?
  voidedById     Int?             @map("voided_by_id")
  voidedAt       DateTime?        @map("voided_at")
  voidReason     String?          @map("void_reason")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  store        Store         @relation(fields: [storeId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  salesperson  User          @relation("SalesOrderSalesperson", fields: [salespersonId], references: [id])
  voidedBy     User?         @relation("SalesOrderVoidedBy", fields: [voidedById], references: [id])
  tradeInOrder TradeInOrder? @relation(fields: [tradeInOrderId], references: [id])
  dailyClose   DailyClose?   @relation(fields: [dailyCloseId], references: [id])

  items        SalesOrderItem[]
  payments     Payment[]
  returnOrders ReturnOrder[]
  entitlements ServiceEntitlement[]
  wecomBindCodes WecomBindCode[]
  repairOrders RepairOrder[]
  carrierBusiness CarrierBusiness[]
  subsidyClaims SubsidyClaim[]
  invoices     Invoice[]

  @@index([storeId, bizDate])
  @@index([salespersonId, bizDate])
  @@map("sales_orders")
}

/// 销售明细
model SalesOrderItem {
  id           Int  @id @default(autoincrement())
  orderId      Int  @map("order_id")
  skuId        Int  @map("sku_id")
  deviceId     Int? @map("device_id") // 大件必填
  qty          Int  @default(1)
  listPriceFen Int? @map("list_price_fen") // 开单时的门店售价（原价）；和成交单价不同就是改过价。旧数据为空
  unitPriceFen Int  @map("unit_price_fen") // 成交单价
  discountFen  Int  @default(0) @map("discount_fen") // 行优惠
  lineTotalFen Int  @map("line_total_fen") // 单价 × 数量 − 行优惠
  costFen      Int  @map("cost_fen") // 成本快照合计，算毛利用
  returnedQty  Int  @default(0) @map("returned_qty") // 数据库 CHECK 0 <= returned_qty <= qty

  order  SalesOrder @relation(fields: [orderId], references: [id])
  sku    Sku        @relation(fields: [skuId], references: [id])
  device Device?    @relation(fields: [deviceId], references: [id])

  returnItems  ReturnOrderItem[]
  entitlement  ServiceEntitlement?
  subsidyClaim SubsidyClaim?
  invoiceLines InvoiceLine[]

  @@index([orderId])
  @@index([deviceId])
  @@map("sales_order_items")
}

/// 支付明细：收款为正，退款为负；一张单可拆多种方式
/// 数据库 CHECK：sales_order_id 和 return_order_id 必须且只能填一个（迁移 integrity_checks）
model Payment {
  id             Int           @id @default(autoincrement())
  salesOrderId   Int?          @map("sales_order_id")
  returnOrderId  Int?          @map("return_order_id")
  repairOrderId  Int?          @map("repair_order_id") // 维修取机结算的收款（口径第 13 节）；三个单据有且只有一个（数据库 CHECK）
  method         PaymentMethod
  amountFen      Int           @map("amount_fen")
  tradeInOrderId Int?          @unique @map("trade_in_order_id") // method = TRADE_IN 时指向回收单
  reference      String? // 交易号等
  createdAt      DateTime      @default(now()) @map("created_at")

  salesOrder   SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  returnOrder  ReturnOrder?  @relation(fields: [returnOrderId], references: [id])
  tradeInOrder TradeInOrder? @relation(fields: [tradeInOrderId], references: [id])
  repairOrder  RepairOrder?  @relation(fields: [repairOrderId], references: [id])

  @@index([salesOrderId])
  @@index([returnOrderId])
  @@index([repairOrderId])
  @@map("payments")
}

/// 退货单
model ReturnOrder {
  id           Int       @id @default(autoincrement())
  orderNo      String    @unique @map("order_no") // RT + yyyyMMdd + 4 位
  storeId      Int       @map("store_id")
  salesOrderId Int       @map("sales_order_id") // 原销售单
  customerId   Int?      @map("customer_id")
  handledById  Int       @map("handled_by_id")
  bizDate      DateTime  @map("biz_date") @db.Date
  refundFen    Int       @map("refund_fen") // 退款合计（正数）
  reason       String?
  dailyCloseId Int?      @map("daily_close_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  store      Store       @relation(fields: [storeId], references: [id])
  salesOrder SalesOrder  @relation(fields: [salesOrderId], references: [id])
  customer   Customer?   @relation(fields: [customerId], references: [id])
  handledBy  User        @relation(fields: [handledById], references: [id])
  dailyClose DailyClose? @relation(fields: [dailyCloseId], references: [id])

  items    ReturnOrderItem[]
  payments Payment[]

  @@index([storeId, bizDate])
  @@index([salesOrderId])
  @@map("return_orders")
}

model ReturnOrderItem {
  id            Int  @id @default(autoincrement())
  returnOrderId Int  @map("return_order_id")
  salesItemId   Int  @map("sales_item_id")
  skuId         Int  @map("sku_id")
  deviceId      Int? @map("device_id")
  qty           Int  @default(1)
  refundFen     Int  @map("refund_fen")

  returnOrder ReturnOrder    @relation(fields: [returnOrderId], references: [id])
  salesItem   SalesOrderItem @relation(fields: [salesItemId], references: [id])
  sku         Sku            @relation(fields: [skuId], references: [id])
  device      Device?        @relation(fields: [deviceId], references: [id])

  @@index([returnOrderId])
  @@map("return_order_items")
}

/// 回收单（以旧换新收旧机）
model TradeInOrder {
  id           Int           @id @default(autoincrement())
  orderNo      String        @unique @map("order_no") // RC + yyyyMMdd + 4 位
  storeId      Int           @map("store_id")
  customerId   Int?          @map("customer_id")
  handledById  Int           @map("handled_by_id")
  deviceCode   String        @map("device_code") // 旧机主码（SN / IMEI1 / IMEI2 规则同入库）；同时会建一条 Device（状态回收）
  modelName    String        @map("model_name") // 旧机机型描述（可能不在我们的 SKU 里）
  skuId        Int?          @map("sku_id") // 能对上 SKU 时填
  condition    String // 成色：全新 / 95 新 / 9 成新 / 8 成新 / 有损
  appraisedFen Int           @map("appraised_fen") // 估价 = 抵扣金额 = 旧机成本
  status       TradeInStatus @default(COMPLETED)
  note         String?
  voidedById   Int?          @map("voided_by_id")
  voidedAt     DateTime?     @map("voided_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  store     Store     @relation(fields: [storeId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])
  handledBy User      @relation("TradeInHandledBy", fields: [handledById], references: [id])
  voidedBy  User?     @relation("TradeInVoidedBy", fields: [voidedById], references: [id])
  sku       Sku?      @relation(fields: [skuId], references: [id])

  device     Device?     // 收回的旧机
  salesOrder SalesOrder? // 被哪张销售单抵扣
  payment    Payment?    // 对应的抵扣支付明细

  @@index([storeId, createdAt])
  @@map("trade_in_orders")
}

// ============================================================
// 日结、KPI、日志、单号
// ============================================================

/// 日结记录：门店 × 营业日一条
model DailyClose {
  id            Int              @id @default(autoincrement())
  closeNo       String           @unique @map("close_no") // DC + yyyyMMdd + 4 位
  storeId       Int              @map("store_id")
  bizDate       DateTime         @map("biz_date") @db.Date
  status        DailyCloseStatus @default(PENDING)
  confirmedById Int?             @map("confirmed_by_id")
  confirmedAt   DateTime?        @map("confirmed_at")
  note          String?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  store       Store @relation(fields: [storeId], references: [id])
  confirmedBy User? @relation(fields: [confirmedById], references: [id])

  lines        DailyCloseLine[]
  salesOrders  SalesOrder[]
  returnOrders ReturnOrder[]
  repairOrders RepairOrder[]

  @@unique([storeId, bizDate])
  @@map("daily_closes")
}

/// 日结明细：按支付方式，系统应收 vs 实收
model DailyCloseLine {
  id           Int           @id @default(autoincrement())
  dailyCloseId Int           @map("daily_close_id")
  method       PaymentMethod
  systemFen    Int           @map("system_fen") // 从支付明细汇总（收款 − 退款）
  actualFen    Int?          @map("actual_fen") // 店长录入的实收
  diffFen      Int?          @map("diff_fen") // 实收 − 系统，差异标红

  dailyClose DailyClose @relation(fields: [dailyCloseId], references: [id])

  @@unique([dailyCloseId, method])
  @@map("daily_close_lines")
}

/// KPI 目标：门店 × 月
model KpiTarget {
  id               Int      @id @default(autoincrement())
  storeId          Int      @map("store_id")
  year             Int
  month            Int
  salesTargetFen   Int      @map("sales_target_fen") // 销售额目标
  profitTargetFen  Int      @map("profit_target_fen") // 毛利目标
  deviceQtyTarget  Int      @map("device_qty_target") // 主机量目标
  tradeInQtyTarget Int      @map("trade_in_qty_target") // 旧机回收台数目标
  updatedAt        DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, year, month])
  @@map("kpi_targets")
}

/// 服务权益（碎屏险、延保）：开单时每个服务行一条；退货退掉服务或销售单作废时置失效，不删除（口径第 12 节）
model ServiceEntitlement {
  id               Int               @id @default(autoincrement())
  customerId       Int               @map("customer_id")
  storeId          Int               @map("store_id") // 开单门店：到期名单按门店范围看
  salesOrderId     Int               @map("sales_order_id")
  salesOrderItemId Int               @unique @map("sales_order_item_id") // 服务行一行一份
  skuId            Int               @map("sku_id")
  deviceId         Int?              @map("device_id") // 保的哪台机器：开单时店员选，同单没有机器时为空
  deviceReturnedAt DateTime?         @map("device_returned_at") // 保的机器退回来了、服务没退：服务照常有效，但不再算这台机器的保障（机器可能再卖给别人）
  startedOn        DateTime          @map("started_on") @db.Date // 生效日：销售单营业日；延保是保修到期次日（营业日 + 12 个月）
  expiresOn        DateTime          @map("expires_on") @db.Date // 到期日（当天 24:00 失效），数据库 CHECK >= 生效日
  status           EntitlementStatus @default(ACTIVE)
  voidedAt         DateTime?         @map("voided_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  customer       Customer       @relation(fields: [customerId], references: [id])
  store          Store          @relation(fields: [storeId], references: [id])
  salesOrder     SalesOrder     @relation(fields: [salesOrderId], references: [id])
  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  sku            Sku            @relation(fields: [skuId], references: [id])
  device         Device?        @relation(fields: [deviceId], references: [id])

  reminders    EntitlementReminder[]
  repairOrders RepairOrder[]

  @@index([customerId, status])
  @@index([storeId, expiresOn])
  @@index([expiresOn, status])
  @@map("service_entitlements")
}

/// 到期提醒：扫描时每条权益每档生成一条（唯一约束保证只提醒一次），门店跟进后记“已联系”
model EntitlementReminder {
  id            Int           @id @default(autoincrement())
  entitlementId Int           @map("entitlement_id")
  stage         ReminderStage
  contactedAt   DateTime?     @map("contacted_at") // 门店联系过客户的时间
  contactedById Int?          @map("contacted_by_id")
  note          String? // 联系结果，如“已续保”“不需要”
  createdAt     DateTime      @default(now()) @map("created_at")

  entitlement ServiceEntitlement @relation(fields: [entitlementId], references: [id])
  contactedBy User?              @relation(fields: [contactedById], references: [id])

  @@unique([entitlementId, stage])
  @@map("entitlement_reminders")
}

/// 维修单（口径第 13 节）：接件 → 检测报价 → 维修 → 取机结算。客户的机器不算门店库存，不写库存流水
model RepairOrder {
  id               Int            @id @default(autoincrement())
  orderNo          String         @unique @map("order_no") // WX + yyyyMMdd + 4 位
  storeId          Int            @map("store_id") // 接件门店
  customerId       Int            @map("customer_id")
  receivedById     Int            @map("received_by_id") // 接件人
  deviceId         Int?           @map("device_id") // 本系统卖出的机器；外面买的为空
  deviceCode       String         @map("device_code") // 接件时的码（系统里的机器存主码）
  modelName        String         @map("model_name")
  salesOrderId     Int?           @map("sales_order_id") // 本店卖这台机器的销售单
  purchasedOn      DateTime?      @map("purchased_on") @db.Date // 购买营业日，保修从这天算
  faultCategory    FaultCategory  @map("fault_category")
  faultDescription String         @map("fault_description")
  appearance       String? // 外观、随机附件
  status           RepairStatus   @default(RECEIVED)
  partsFen         Int?           @map("parts_fen") // 配件费
  laborFen         Int?           @map("labor_fen") // 工时费
  costFen          Int?           @map("cost_fen") // 维修成本（店长以上看）
  payer            RepairPayer?
  entitlementId    Int?           @map("entitlement_id") // 用的碎屏险 / 延保
  chargeFen        Int            @default(0) @map("charge_fen") // 客户应付（数据库 CHECK >= 0）
  outcome          RepairOutcome?
  repairNote       String?        @map("repair_note")
  quotedAt         DateTime?      @map("quoted_at")
  approvedAt       DateTime?      @map("approved_at")
  readyAt          DateTime?      @map("ready_at")
  closedAt         DateTime?      @map("closed_at")
  closedById       Int?           @map("closed_by_id")
  bizDate          DateTime?      @map("biz_date") @db.Date // 取机结算的营业日：收款算在这天的日结里
  dailyCloseId     Int?           @map("daily_close_id")
  voidedAt         DateTime?      @map("voided_at")
  voidedById       Int?           @map("voided_by_id")
  voidReason       String?        @map("void_reason")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  store       Store               @relation(fields: [storeId], references: [id])
  customer    Customer            @relation(fields: [customerId], references: [id])
  receivedBy  User                @relation("RepairReceivedBy", fields: [receivedById], references: [id])
  closedBy    User?               @relation("RepairClosedBy", fields: [closedById], references: [id])
  voidedBy    User?               @relation("RepairVoidedBy", fields: [voidedById], references: [id])
  device      Device?             @relation(fields: [deviceId], references: [id])
  salesOrder  SalesOrder?         @relation(fields: [salesOrderId], references: [id])
  entitlement ServiceEntitlement? @relation(fields: [entitlementId], references: [id])
  dailyClose  DailyClose?         @relation(fields: [dailyCloseId], references: [id])

  payments Payment[]

  @@index([storeId, status])
  @@index([storeId, bizDate])
  @@index([deviceCode])
  @@index([customerId])
  @@map("repair_orders")
}

/// 运营商佣金政策（口径第 14 节）：运营商 × 业务类型一条，总部维护
model CarrierCommissionRule {
  id             Int            @id @default(autoincrement())
  carrier        Carrier
  bizType        CarrierBizType @map("biz_type")
  commissionFen  Int            @map("commission_fen") // 每笔佣金（数据库 CHECK >= 0）
  clawbackMonths Int            @map("clawback_months") // 返销期：几个月内销户要扣回（0～24）
  isActive       Boolean        @default(true) @map("is_active")
  note           String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@unique([carrier, bizType])
  @@map("carrier_commission_rules")
}

/// 运营商业务单：门店办一笔登记一笔；佣金按登记时的政策记预计，按月结算单记实收或返销
model CarrierBusiness {
  id                    Int              @id @default(autoincrement())
  orderNo               String           @unique @map("order_no") // YY + yyyyMMdd + 4 位
  storeId               Int              @map("store_id")
  handledById           Int              @map("handled_by_id") // 经办店员（提成算给他）
  customerId            Int?             @map("customer_id")
  carrier               Carrier
  bizType               CarrierBizType   @map("biz_type")
  phone                 String // 办理的号码（宽带填联系电话），列表脱敏；不存身份证号
  packageName           String           @map("package_name")
  monthlyFeeFen         Int?             @map("monthly_fee_fen")
  carrierOrderNo        String?          @map("carrier_order_no") // 运营商系统的受理单号（对账用）
  salesOrderId          Int?             @map("sales_order_id") // 合约机：本店卖机器的那张单
  bizDate               DateTime         @map("biz_date") @db.Date // 登记营业日（结算月份按它算）
  expectedCommissionFen Int              @map("expected_commission_fen") // 登记时按政策记下的预计佣金
  clawbackMonths        Int              @map("clawback_months")
  status                CarrierBizStatus @default(SUBMITTED)
  activatedAt           DateTime?        @map("activated_at")
  failedReason          String?          @map("failed_reason")
  settlementId          Int?             @map("settlement_id")
  settledFen            Int?             @map("settled_fen") // 结算单里实给的佣金
  clawbackFen           Int?             @map("clawback_fen") // 被扣回的金额
  voidedAt              DateTime?        @map("voided_at")
  voidedById            Int?             @map("voided_by_id")
  voidReason            String?          @map("void_reason")
  note                  String?
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  store      Store              @relation(fields: [storeId], references: [id])
  handledBy  User               @relation("CarrierHandledBy", fields: [handledById], references: [id])
  voidedBy   User?              @relation("CarrierVoidedBy", fields: [voidedById], references: [id])
  customer   Customer?          @relation(fields: [customerId], references: [id])
  salesOrder SalesOrder?        @relation(fields: [salesOrderId], references: [id])
  settlement CarrierSettlement? @relation(fields: [settlementId], references: [id])

  settlementLines CarrierSettlementLine[]

  @@index([storeId, bizDate])
  @@index([carrier, status])
  @@index([carrierOrderNo])
  @@index([phone])
  @@map("carrier_business")
}

/// 运营商结算单：一个运营商一个月一张，只能对一次（口径第 14 节）
model CarrierSettlement {
  id                 Int                     @id @default(autoincrement())
  settlementNo       String                  @unique @map("settlement_no") // JS + yyyyMMdd + 4 位
  carrier            Carrier
  month              String // 结算月份，如 2026-09
  source             CarrierSettlementSource
  importedById       Int                     @map("imported_by_id")
  lineCount          Int                     @map("line_count")
  matchedCount       Int                     @map("matched_count")
  diffCount          Int                     @map("diff_count")
  unmatchedCount     Int                     @map("unmatched_count")
  missingCount       Int                     @map("missing_count") // 我们登记了、结算单里没有的
  totalCommissionFen Int                     @map("total_commission_fen")
  totalClawbackFen   Int                     @map("total_clawback_fen")
  createdAt          DateTime                @default(now()) @map("created_at")

  importedBy User @relation(fields: [importedById], references: [id])

  lines      CarrierSettlementLine[]
  businesses CarrierBusiness[]

  @@unique([carrier, month])
  @@map("carrier_settlements")
}

/// 结算单的一行
model CarrierSettlementLine {
  id             Int               @id @default(autoincrement())
  settlementId   Int               @map("settlement_id")
  carrierOrderNo String?           @map("carrier_order_no")
  phone          String?
  bizType        CarrierBizType?   @map("biz_type")
  commissionFen  Int               @map("commission_fen")
  clawbackFen    Int               @map("clawback_fen")
  businessId     Int?              @map("business_id") // 对上的业务单
  result         CarrierLineResult

  settlement CarrierSettlement @relation(fields: [settlementId], references: [id])
  business   CarrierBusiness?  @relation(fields: [businessId], references: [id])

  @@index([settlementId])
  @@map("carrier_settlement_lines")
}

/// 审批规则（口径第 17 节）：每个场景一条，总部维护，默认关
model ApprovalRule {
  id           Int              @id @default(autoincrement())
  kind         ApprovalRuleKind @unique
  enabled      Boolean          @default(false)
  thresholdFen Int?             @map("threshold_fen") // 金额门槛
  thresholdBp  Int?             @map("threshold_bp") // 比例门槛（万分之几，只有开单让利用）
  approverRole Role             @map("approver_role") // STORE_MANAGER 或 HQ
  note         String?
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@map("approval_rules")
}

/// 审批单：触发了规则的事先存在这里，批了再按当时的数据做掉
model ApprovalRequest {
  id            Int            @id @default(autoincrement())
  requestNo     String         @unique @map("request_no") // SP + yyyyMMdd + 4 位
  action        ApprovalAction
  storeId       Int            @map("store_id")
  requestedById Int            @map("requested_by_id")
  approverRole  Role           @map("approver_role")
  status        ApprovalStatus @default(PENDING)
  summary       String // 给审批人看的摘要
  reasons       Json // 触发了哪几条规则、为什么
  amountFen     Int            @map("amount_fen") // 关键金额（让利、退款、货值）
  note          String? // 发起人的说明
  payload       Json // 做这件事要的全部内容
  dedupeKey     String?        @map("dedupe_key") // 同一件事同时只能有一张待审批（部分唯一索引）
  decidedById   Int?           @map("decided_by_id")
  decidedAt     DateTime?      @map("decided_at")
  decisionNote  String?        @map("decision_note")
  resultId      Int?           @map("result_id") // 做出来的单据 id
  resultNo      String?        @map("result_no") // 做出来的单号
  error         String? // 没做成的原因
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  store       Store @relation(fields: [storeId], references: [id])
  requestedBy User  @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User? @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])

  @@index([status, approverRole])
  @@index([storeId, createdAt])
  @@index([requestedById])
  @@map("approval_requests")
}

/// 公司开票信息（销售方，口径第 16 节）：只有一行，总部维护
model InvoiceSeller {
  id           Int      @id @default(1)
  name         String // 公司名称
  taxNo        String   @map("tax_no") // 纳税人识别号
  addressPhone String   @map("address_phone")
  bankAccount  String   @map("bank_account") // 开户行及账号
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("invoice_seller")
}

/// 开票申请 / 发票（口径第 16 节）：一张销售单同时只能有一张在办的（待开票、已开票、需红冲，部分唯一索引）
model Invoice {
  id                Int                 @id @default(autoincrement())
  requestNo         String              @unique @map("request_no") // KP + yyyyMMdd + 4 位
  storeId           Int                 @map("store_id")
  salesOrderId      Int                 @map("sales_order_id")
  customerId        Int?                @map("customer_id")
  kind              InvoiceKind
  titleType         InvoiceTitleType    @map("title_type")
  titleName         String              @map("title_name") // 抬头
  buyerTaxNo        String?             @map("buyer_tax_no")
  buyerAddressPhone String?             @map("buyer_address_phone") // 专票要
  buyerBankAccount  String?             @map("buyer_bank_account") // 专票要
  receiver          String? // 电子票的接收邮箱或手机
  amountFen         Int                 @map("amount_fen") // 价税合计 = 明细合计（数据库 CHECK > 0）
  taxFen            Int                 @map("tax_fen") // 税额合计 = 明细合计
  status            InvoiceStatus       @default(REQUESTED)
  requestedById     Int                 @map("requested_by_id")
  invoiceNumber     String?             @map("invoice_number") // 税务发票号码（开了才有，部分唯一索引）
  issueSource       InvoiceIssueSource? @map("issue_source")
  issuedAt          DateTime?           @map("issued_at")
  issuedById        Int?                @map("issued_by_id")
  sellerSnapshot    Json?               @map("seller_snapshot") // 开具时的销售方信息
  deliveredAt       DateTime?           @map("delivered_at") // 纸质票到店
  redNumber         String?             @map("red_number") // 红字发票号码（部分唯一索引，迁移 invoice_red_number_unique）
  redAt             DateTime?           @map("red_at")
  redById           Int?                @map("red_by_id")
  redReason         String?             @map("red_reason")
  cancelledAt       DateTime?           @map("cancelled_at")
  cancelReason      String?             @map("cancel_reason")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  store       Store       @relation(fields: [storeId], references: [id])
  salesOrder  SalesOrder  @relation(fields: [salesOrderId], references: [id])
  customer    Customer?   @relation(fields: [customerId], references: [id])
  requestedBy User        @relation("InvoiceRequestedBy", fields: [requestedById], references: [id])
  issuedBy    User?       @relation("InvoiceIssuedBy", fields: [issuedById], references: [id])
  redBy       User?       @relation("InvoiceRedBy", fields: [redById], references: [id])

  lines InvoiceLine[]

  @@index([storeId, createdAt])
  @@index([salesOrderId])
  @@index([status])
  @@map("invoices")
}

/// 发票明细：一个商品一行，金额含税
model InvoiceLine {
  id               Int     @id @default(autoincrement())
  invoiceId        Int     @map("invoice_id")
  salesOrderItemId Int     @map("sales_order_item_id")
  name             String // 商品名称
  spec             String? // 规格（机器写串号）
  qty              Int
  amountFen        Int     @map("amount_fen") // 含税金额
  taxRateBp        Int     @map("tax_rate_bp") // 税率，万分之几：1300 = 13%
  taxFen           Int     @map("tax_fen")

  invoice        Invoice        @relation(fields: [invoiceId], references: [id])
  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])

  @@index([invoiceId])
  @@map("invoice_lines")
}

/// 国补政策（口径第 15 节）：按品类一条，总部维护
model SubsidyPolicy {
  id          Int      @id @default(autoincrement())
  categoryId  Int      @unique @map("category_id")
  rateBp      Int      @map("rate_bp") // 补贴比例，万分之几：1500 = 15%（数据库 CHECK 1～10000）
  capFen      Int      @map("cap_fen") // 单件封顶
  priceCapFen Int      @map("price_cap_fen") // 成交价超过这个数不补
  startsOn    DateTime @map("starts_on") @db.Date
  endsOn      DateTime @map("ends_on") @db.Date // 含这一天
  isActive    Boolean  @default(true) @map("is_active")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category      @relation(fields: [categoryId], references: [id])
  claims   SubsidyClaim[]

  @@map("subsidy_policies")
}

/// 国补单：每台补贴的机器一张，开单时生成；收款里那笔“国补立减”等于这张单所有国补单的补贴合计
model SubsidyClaim {
  id                Int                @id @default(autoincrement())
  claimNo           String             @unique @map("claim_no") // GB + yyyyMMdd + 4 位
  storeId           Int                @map("store_id")
  salesOrderId      Int                @map("sales_order_id")
  salesOrderItemId  Int                @unique @map("sales_order_item_id")
  customerId        Int                @map("customer_id")
  deviceId          Int                @map("device_id")
  policyId          Int                @map("policy_id")
  categoryId        Int                @map("category_id")
  bizDate           DateTime           @map("biz_date") @db.Date // 开单营业日（每人每类一台按它落在哪条政策期内算）
  basePriceFen      Int                @map("base_price_fen") // 分摊整单优惠后的成交价
  subsidyFen        Int                @map("subsidy_fen") // 数据库 CHECK 0 < subsidy <= base
  qualificationCode String             @map("qualification_code") // 顾客的补贴资格码（平台核销码）
  invoiceNo         String?            @map("invoice_no")
  status            SubsidyClaimStatus @default(PENDING)
  submittedAt       DateTime?          @map("submitted_at")
  reviewedAt        DateTime?          @map("reviewed_at")
  rejectReason      String?            @map("reject_reason")
  settledAt         DateTime?          @map("settled_at")
  settledFen        Int?               @map("settled_fen")
  cancelledAt       DateTime?          @map("cancelled_at")
  returnedAt        DateTime?          @map("returned_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  store          Store          @relation(fields: [storeId], references: [id])
  salesOrder     SalesOrder     @relation(fields: [salesOrderId], references: [id])
  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  customer       Customer       @relation(fields: [customerId], references: [id])
  device         Device         @relation(fields: [deviceId], references: [id])
  policy         SubsidyPolicy  @relation(fields: [policyId], references: [id])
  category       Category       @relation(fields: [categoryId], references: [id])

  @@index([storeId, bizDate])
  @@index([customerId, categoryId])
  @@index([salesOrderId])
  @@index([status])
  @@index([qualificationCode])
  @@map("subsidy_claims")
}

/// 企业微信跟进关系：员工 × 外部联系人（口径第 12 节）。客户可以先有跟进关系、后绑定档案（customerId 为空 = 还没绑定）
model WecomFollow {
  id             Int               @id @default(autoincrement())
  externalUserid String            @map("external_userid")
  wecomUserid    String            @map("wecom_userid") // 跟进员工的企业微信 userid
  userId         Int?              @map("user_id") // 对应的 ERP 员工（按 wecomUserid 找，可能还没对上）
  customerId     Int?              @map("customer_id") // 绑定后指向 ERP 客户
  status         WecomFollowStatus @default(ACTIVE)
  deletedBy      String?           @map("deleted_by") // 谁删的谁：EMPLOYEE 员工删了客户 / CUSTOMER 客户删了员工 / TRANSFERRED 继承给了别人
  state          String? // 加好友时活码带的 state（开单绑定码），追渠道用
  firstAddAt     DateTime          @map("first_add_at")
  deletedAt      DateTime?         @map("deleted_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  customer  Customer?       @relation(fields: [customerId], references: [id])
  user      User?           @relation(fields: [userId], references: [id])
  transfers WecomTransfer[]

  @@unique([externalUserid, wecomUserid])
  @@index([customerId])
  @@index([userId, status])
  @@map("wecom_follows")
}

/// 企业标签（企业微信标签的镜像）
model WecomTag {
  id        Int      @id @default(autoincrement())
  groupName String   @map("group_name") // 标签组，如“已购机型”
  tagId     String   @unique @map("tag_id") // 企业微信里的标签 id
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  customers WecomCustomerTag[]

  @@map("wecom_tags")
}

/// 客户身上的标签
model WecomCustomerTag {
  customerId Int            @map("customer_id")
  tagId      Int            @map("tag_id")
  source     WecomTagSource
  createdAt  DateTime       @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id])
  tag      WecomTag @relation(fields: [tagId], references: [id])

  @@id([customerId, tagId])
  @@map("wecom_customer_tags")
}

/// 开单绑定码：开单后店员点“生成加企业微信二维码”时建，带着它的活码（联系我）只认这一个客户。
/// 客户扫码加好友，回调里的 state 就是这个码，按它精确绑定；绑定成功或过期后删掉企业微信那边的活码配置。
model WecomBindCode {
  code               String    @id // 短码，同时是活码的 state（企业微信限 30 个字符）
  customerId         Int       @map("customer_id")
  salesOrderId       Int       @map("sales_order_id")
  storeId            Int       @map("store_id")
  userId             Int       @map("user_id") // 接待员工 = 开单人
  configId           String?   @unique @map("config_id") // 企业微信返回的活码配置 id
  qrCodeUrl          String?   @map("qr_code_url") // 企业微信返回的二维码地址（模拟模式为空，页面画占位图）
  expiresAt          DateTime  @map("expires_at") // 生成后 30 天
  usedAt             DateTime? @map("used_at") // 绑定成功的时间
  contactWayDeletedAt DateTime? @map("contact_way_deleted_at") // 活码配置删掉的时间
  createdAt          DateTime  @default(now()) @map("created_at")

  customer   Customer   @relation(fields: [customerId], references: [id])
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
  store      Store      @relation(fields: [storeId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@index([salesOrderId])
  @@index([expiresAt])
  @@map("wecom_bind_codes")
}

/// 企业微信回调事件：先落库再处理；去重键是解密后整段明文的 sha256（企业微信重试时明文相同）
model WecomEvent {
  id          Int              @id @default(autoincrement())
  eventKey    String           @unique @map("event_key")
  source      String // CONTACT 客户联系 / KF 微信客服
  simulated   Boolean          @default(false) // 演示里“模拟扫码加好友”造的事件
  eventType   String           @map("event_type")
  changeType  String?          @map("change_type")
  payload     Json // 解密后的字段
  status      WecomEventStatus @default(PENDING)
  error       String?
  receivedAt  DateTime         @default(now()) @map("received_at")
  processedAt DateTime?        @map("processed_at")

  @@index([status, receivedAt])
  @@map("wecom_events")
}

/// 智能提醒命中的一条（口径第 18 节）：同一天同一个范围同一类只有一条，再生成就更新
model AlertItem {
  id        Int        @id @default(autoincrement())
  bizDate   DateTime   @map("biz_date") @db.Date
  kind      AlertKind
  scope     AlertScope
  scopeKey  String     @map("scope_key") // store:门店id / region:区域id / hq
  storeId   Int?       @map("store_id")
  regionId  Int?       @map("region_id")
  severity  Int // 1 一般、2 要紧、3 很急（程序定，数据库 CHECK 1～3）
  title     String
  detail    String // 程序写的一句话，模板版就用它
  link      String?
  facts     Json // 程序算好的数字，交给模型的就是这些
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@unique([bizDate, kind, scopeKey])
  @@index([scopeKey, bizDate])
  @@map("alert_items")
}

/// 今日待办：一个范围一天一份（门店、区域、总部），再生成就更新
model AlertDigest {
  id             Int               @id @default(autoincrement())
  bizDate        DateTime          @map("biz_date") @db.Date
  scope          AlertScope
  scopeKey       String            @map("scope_key")
  storeId        Int?              @map("store_id")
  regionId       Int?              @map("region_id")
  title          String
  content        String // markdown
  source         AlertDigestSource
  fallbackReason String?           @map("fallback_reason") // 为什么没用模型写（没开、出错、超额、数字对不上）
  itemCount      Int               @map("item_count")
  pushStatus     String?           @map("push_status") // SENT 发了 / SIMULATED 演示没真发 / FAILED 没发出去 / NONE 门店没填群地址
  pushError      String?           @map("push_error")
  pushedAt       DateTime?         @map("pushed_at")
  generatedAt    DateTime          @map("generated_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  notifications Notification[]

  @@unique([bizDate, scopeKey])
  @@map("alert_digests")
}

/// 系统内消息（顶栏小铃铛）：一个人一份今日待办一条；内容变了重新标未读
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  digestId  Int?      @map("digest_id")
  title     String
  body      String // 一两行摘要
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user   User         @relation(fields: [userId], references: [id])
  digest AlertDigest? @relation(fields: [digestId], references: [id], onDelete: Cascade)

  @@unique([userId, digestId])
  @@index([userId, readAt])
  @@map("notifications")
}

/// 调用大模型的记录（口径第 18 节）：每天的调用上限按它数；记用了多少 token，好估花了多少钱。不存提示和回答的全文
model LlmCall {
  id               Int      @id @default(autoincrement())
  purpose          String // 做什么用：alerts 今日待办
  model            String // 模型名；模拟模型记 simulated
  ok               Boolean
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  latencyMs        Int      @map("latency_ms")
  error            String?
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("llm_calls")
}

/// 企业微信客户继承（口径第 12 节第三步）：一个客户的一条跟进关系一条；同一条跟进关系同时只能有一个没办完的（部分唯一索引）
model WecomTransfer {
  id              Int                 @id @default(autoincrement())
  kind            WecomTransferKind
  followId        Int                 @map("follow_id") // 原来那条跟进关系
  externalUserid  String              @map("external_userid")
  customerId      Int?                @map("customer_id")
  fromUserId      Int?                @map("from_user_id") // 原跟进员工（ERP 里对得上才有）
  fromWecomUserid String              @map("from_wecom_userid")
  toUserId        Int                 @map("to_user_id") // 接手人
  toWecomUserid   String              @map("to_wecom_userid")
  status          WecomTransferStatus
  createdById     Int                 @map("created_by_id")
  submittedAt     DateTime?           @map("submitted_at")
  finishedAt      DateTime?           @map("finished_at")
  error           String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  follow    WecomFollow @relation(fields: [followId], references: [id])
  customer  Customer?   @relation(fields: [customerId], references: [id])
  fromUser  User?       @relation("WecomTransferFrom", fields: [fromUserId], references: [id])
  toUser    User        @relation("WecomTransferTo", fields: [toUserId], references: [id])
  createdBy User        @relation("WecomTransferCreatedBy", fields: [createdById], references: [id])

  @@index([status])
  @@index([externalUserid, createdAt])
  @@index([fromUserId])
  @@map("wecom_transfers")
}

/// 微信客服拉消息的游标：每个客服账号一个，拉完一页就存（官方建议游标入库，不然重启后会重复拉或漏拉）
model WecomKfCursor {
  openKfid  String   @id @map("open_kfid")
  cursor    String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("wecom_kf_cursors")
}

/// 微信客服会话：一个客服账号 × 一个客户一条，记现在谁在接、能不能再发
model WecomKfSession {
  id             Int                 @id @default(autoincrement())
  openKfid       String              @map("open_kfid")
  externalUserid String              @map("external_userid") // 客服渠道的客户 id
  customerId     Int?                @map("customer_id") // 认出来的客户档案（这个微信绑定过才有；每条消息重新认）
  state          WecomKfSessionState @default(AUTO)
  lastInAt       DateTime?           @map("last_in_at") // 客户最后一次发消息（48 小时窗口从这里算）
  outSinceIn     Int                 @default(0) @map("out_since_in") // 客户上次发消息后回了几条（最多 5，数据库 CHECK 0～5）
  missCount      Int                 @default(0) @map("miss_count") // 连着几句没听懂（到 2 句转人工）
  humanAt        DateTime?           @map("human_at") // 转人工的时间
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  customer Customer?        @relation(fields: [customerId], references: [id])
  messages WecomKfMessage[]

  @@unique([openKfid, externalUserid])
  @@index([updatedAt])
  @@map("wecom_kf_sessions")
}

/// 微信客服消息：按企业微信的消息 id 去重；只有总部能看，留 180 天
model WecomKfMessage {
  id        Int              @id @default(autoincrement())
  msgid     String           @unique // 企业微信的消息 id；没发出去的自动答复用本地生成的 id
  sessionId Int              @map("session_id")
  direction WecomKfDirection
  msgType   String           @map("msg_type") // text、image、event……
  content   String // 文字内容；不是文字的写“[图片]”这类说明
  intent    String? // 认出来的意图（客户发来的文字）
  delivered Boolean          @default(true) // 发出去了没有（超过 48 小时或 5 条就不发，记下来）
  note      String? // 系统备注：转人工、没发出去的原因、人工回复
  sentAt    DateTime         @map("sent_at")
  createdAt DateTime         @default(now()) @map("created_at")

  session WecomKfSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, sentAt])
  @@index([sentAt])
  @@map("wecom_kf_messages")
}

/// 企业微信 access_token 缓存：不加 Redis，落库；服务层统一读写，过期前 5 分钟刷新
model WecomTokenCache {
  key       String   @id // 只有一种：app（自建应用 Secret 换的令牌）
  token     String
  expiresAt DateTime @map("expires_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("wecom_token_cache")
}

/// 操作日志：谁、什么时候、做了什么、对哪条记录
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String // 如 login、logout、store.update、sales_order.void
  entity    String? // 表名或业务对象名
  entityId  String?  @map("entity_id")
  detail    Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

/// 单号计数器：key = 前缀 + yyyyMMdd，在事务里自增，保证同一天单号不重
model DocCounter {
  key   String @id
  value Int    @default(0)

  @@map("doc_counters")
}
