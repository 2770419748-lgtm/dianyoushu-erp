# 依赖
node_modules/
.pnpm-store/
.pnpm-debug.log*

# 环境变量：密码、密钥只放这里，永远不提交（.env.example 是模板，可以提交）
.env
.env.*
!.env.example

# Next.js 构建产物
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# 测试与其他产物
coverage/
dist/

# 日志、证书、系统文件
*.log
*.pem
.DS_Store
Thumbs.db

# Prisma 生成的客户端代码（pnpm install 后自动生成）
src/generated/

# Playwright 输出
/test-results/
/playwright-report/

# 服务器上的数据库备份（docker compose 的 backup 服务写进来），不进仓库
backups/

# 全量导出（pnpm export:all）：明文个人信息，交接完就删，永远不进仓库
exports/
